rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnderMaxSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB Max
    }

    // Public avatars and covers
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnderMaxSize();
    }

    // Store products images
    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnderMaxSize();
    }

    // Payment receipts (proofs)
    match /receipts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isUnderMaxSize();
    }

    // Default rule: Anyone can view public assets, authenticated users can upload images
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isUnderMaxSize();
    }
  }
}
