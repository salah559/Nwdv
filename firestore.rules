rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'novawebdv@gmail.com' ||
        request.auth.token.email == 'admin@novawebdv.com'
      );
    }

    // 1. User Profiles: Publicly readable so visitors can view portfolios & stores
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if isOwner(userId) || isAdmin();

      // Subcollection for profile orders if used
      match /orders/{orderId} {
        allow read, write: if true;
      }
    }

    // 2. Usernames registry for uniqueness checking
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 3. Subscriptions: readable by public (for trial/active status on profiles)
    match /subscriptions/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // 4. Store Orders (مثل Shopify - متاح للزبائن وضع الطلبات بدون تسجيل دخول)
    match /orders/{orderId} {
      // Any visitor can place an order from a store
      allow create: if true;
      
      // Store owners can read and manage their orders, visitors can read their submitted order
      allow read: if true;
      
      // Store owners or admin can update order status (confirmed, shipping, delivered, cancelled)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
      
      // Store owners or admin can delete orders
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
    }

    // 5. Payment proofs & receipts
    match /payments/{paymentId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 6. Template Purchases
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 7. Fallback for any other collection
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }
  }
}
